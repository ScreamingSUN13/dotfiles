{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "height": 15,
        "width": 30,
        "padding": {
            "top": 5,
            "left": 3
        }
    },
		"display": {
	  	"size": {
	    	"binaryPrefix": "jedec"
   		}
  	},
    "modules": [
				{
					"type": "custom",
					"format": "\u001b[90m╭────────────────────────User────────────────────────╮"
				},
				{
					"type": "title",
					"key": "├ ",
					"keyColor": "green"
				},
				{
          "type": "custom",
          "format": "\u001b[90m╰────────────────────────────────────────────────────╯"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m╭──────────────────────Hardware──────────────────────╮"
        },
				{
            "type": "cpu",
            "key": "├ ",
            "keyColor": "#1793D1"
        },
        {
            "type": "gpu",
            "key": "├󰢮 ",
            "keyColor": "#1793D1"
        },
        {
            "type": "memory",
            "key": "├ ",
            "keyColor": "#1793D1"
        },
				{
						"type": "board",
						"key": "├󰚗 ",
						"keyColor": "#1793D1"
				},
        {
            "type": "disk",
            "key": "├󰋊 ",
            "keyColor": "#1793D1",
						"unitType": "si"
        },
        {
            "type": "custom",
            "format": "\u001b[90m╰────────────────────────────────────────────────────╯"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m╭──────────────────────Software──────────────────────╮"
        },
				{
            "type": "os",
            "key": "  OS",
            "keyColor": "#FF7500"
				},
        {
            "type": "kernel",
            "key": "│ ├ ",
            "keyColor": "#FF7500"
        },
        /*{
            "type": "bios",
            "key": "│ ├󰖡 ",
            "keyColor": "#FF7500"
        },*/
        {
            "type": "packages",
            "key": "│ ├󰏗 ",
            "keyColor": "#FF7500"
				},
				{
            "type": "shell",
            "key": "└ └󰞷 ",
            "keyColor": "#FF7500"
        },
				{
            "type": "custom",
            "key": "󰧨  DE",
            "keyColor": "#FAC000",
						"format": "Aqua"
        },
        {
            "type": "lm",
            "key": "│ ├󰍁 ",
            "keyColor": "#FAC000"
        },
        {
            "type": "wm",
            "key": "│ ├󱂬 ",
            "keyColor": "#FAC000"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉦 ",
            "keyColor": "#FAC000"
        },
        {
            "type": "terminal",
            "key": "│ └󰆍 ",
            "keyColor": "#FAC000"
        },
        {
            "type": "custom",
            "format": "\u001b[90m╰────────────────────────────────────────────────────╯"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m╭─────────────────Uptime / Age / DT──────────────────╮"
        },
        {
            "type": "command",
            "key": "├ ›  OS Age   ",
            "keyColor": "#19ad84",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "├ ›  Uptime   ",
            "keyColor": "#19ad84"
        },
        {
            "type": "datetime",
            "key": "├ ›  DateTime ",
            "keyColor": "#19ad84"
        },
        {
            "type": "custom",
            "format": "\u001b[90m╰────────────────────────────────────────────────────╯"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle",
						"range": "both"
        }
    ]
}
