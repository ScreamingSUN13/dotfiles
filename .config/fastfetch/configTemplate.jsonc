{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
			"source": "cachyos",
			"padding": {
					"top": 5,
					"left": 3
			},
			"color": {
					"1": "#16A085",
					"2": "#19BC9C"
			}
    },
		"display": {
	  	"size": {
	    	"binaryPrefix": "jedec"
   		}
  	},
    "modules": [
				{
					"type": "custom",
					"format": "\u001b[90m╭────────────────────────User────────────────────────╮"
				},
				{
					"type": "title",
					"key": "├ ",
					"keyColor": "green"
				},
				{
          "type": "custom",
          "format": "\u001b[90m╰────────────────────────────────────────────────────╯"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m╭──────────────────────Hardware──────────────────────╮"
        },
				{
            "type": "cpu",
            "key": "├ ",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "gpu",
            "key": "├󰢮 ",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "memory",
            "key": "├ ",
            "keyColor": "{{colors.primary.default.hex}}"
        },
				{
						"type": "board",
						"key": "├󰚗 ",
						"keyColor": "{{colors.primary.default.hex}}"
				},
        {
            "type": "disk",
            "key": "├󰋊 ",
            "keyColor": "{{colors.primary.default.hex}}",
						"unitType": "si"
        },
        {
            "type": "custom",
            "format": "\u001b[90m╰────────────────────────────────────────────────────╯"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m╭──────────────────────Software──────────────────────╮"
        },
				{
            "type": "os",
            "key": "  OS",
            "keyColor": "{{colors.secondary.default.hex}}"
				},
        {
            "type": "kernel",
            "key": "│ ├ ",
            "keyColor": "{{colors.secondary.default.hex}}"
        },
        /*{
            "type": "bios",
            "key": "│ ├󰖡",
            "keyColor": "{{colors.secondary.default.hex}}"
        },*/
        {
            "type": "command",
            "key": "│ ├󰏗 ",
            "keyColor": "{{colors.secondary.default.hex}}",
						"text": "./pkgcount.bash"
				},
				{
            "type": "shell",
            "key": "└ └󰞷 ",
            "keyColor": "{{colors.secondary.default.hex}}"
        },
        {
            "type": "wm",
            "key": "󰧨  WM",
            "keyColor": "{{colors.secondary.default.hex}}"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉦 ",
            "keyColor": "{{colors.secondary.default.hex}}"
        },
        {
            "type": "terminal",
            "key": "│ ├󰆍 ",
            "keyColor": "{{colors.secondary.default.hex}}"
        },
        {
            "type": "lm",
            "key": "│ └󰍁 ",
            "keyColor": "{{colors.secondary.default.hex}}"
        },
        {
            "type": "custom",
            "format": "\u001b[90m╰────────────────────────────────────────────────────╯"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m╭─────────────────Uptime / Age / DT──────────────────╮"
        },
        {
            "type": "command",
            "key": "├ ›  OS Age   ",
            "keyColor": "{{colors.tertiary.default.hex}}",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "├ ›  Uptime   ",
            "keyColor": "{{colors.tertiary.default.hex}}"
        },
        {
            "type": "datetime",
            "key": "├ ›  DateTime ",
            "keyColor": "{{colors.tertiary.default.hex}}"
        },
        {
            "type": "custom",
            "format": "\u001b[90m╰────────────────────────────────────────────────────╯"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle",
						"range": "both"
        }
    ]
}
