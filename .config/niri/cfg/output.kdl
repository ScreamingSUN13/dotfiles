// Output arrangment
// BenQ
output "DP-3" {
	mode "1920x1080@143.996"
	scale 1

  position x=0 y=0
	backdrop-color "#0b0e14"
}
// LG
output "DP-1" {
	mode "1920x1080@143.981"
	scale 1

  position x=1920 y=0
	backdrop-color "#0b0e14"
}
// Philips
output "Philips Consumer Electronics Company PHL 241V8LB TP02535011084" {
	position x=3840 y=0
	mode "1920x1080@100.000"
	scale 1
	backdrop-color "#0b0e14"
}
