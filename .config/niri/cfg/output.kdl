output "HDMI-A-1" {
    mode "1920x1080@60.000"

    scale 1.0

    transform "normal"
    position x=3802 y=1080
}
output "DP-2" {
    mode "1920x1080@100.000"

    scale 1.0

    transform "normal"
    position x=3802 y=2160
}


